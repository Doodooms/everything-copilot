{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-workflow:expertise-pack:1",
  "title": "Agentic Workflow Expertise Pack Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "name",
    "version",
    "description",
    "compatibility",
    "trust",
    "capabilities",
    "dependencies",
    "agents",
    "skills",
    "mcp_config",
    "mcp_servers",
    "projections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/packId"
    },
    "type": {
      "enum": [
        "horizontal",
        "vertical"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "agent_plugins"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "portable",
              "copilot",
              "codex",
              "codex"
            ]
          }
        },
        "agent_plugins": {
          "$ref": "#/$defs/agentPluginsRequirement"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "source",
        "approval_required"
      ],
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "approval_required": {
          "const": true
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "agents": {
      "$ref": "#/$defs/agents"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "mcp_config": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/relativePath"
        }
      ]
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projection"
      }
    }
  },
  "$defs": {
    "packId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "agentPluginsRequirement": {
      "type": "string",
      "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*))?$(?![\\s\\S])"
    },
    "capabilityList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capabilityId"
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capabilityId"
        },
        "pack_id": {
          "$ref": "#/$defs/packId"
        },
        "minimum_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributions",
        "extensions"
      ],
      "properties": {
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "capabilities"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/componentId"
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              },
              "capabilities": {
                "$ref": "#/$defs/capabilityList"
              }
            }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "capabilities"
            ],
            "properties": {
              "agent_id": {
                "$ref": "#/$defs/componentId"
              },
              "capabilities": {
                "$ref": "#/$defs/capabilityList"
              }
            }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capabilities",
        "permissions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\s]+$"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "capabilities",
        "skills",
        "mcp_servers"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/componentId"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "mcp_servers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        }
      }
    }
  }
}
