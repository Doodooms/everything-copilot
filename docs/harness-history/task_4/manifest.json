      "id": "SPEC-CORE-ENHANCEMENTS",
      "non_goals": [
        "A central tool-call gateway.",
        "Automatic quota polling or private account API access.",
        "External runtime or provider integration without a measured product requirement."
      ],
      "objective": "Improve agentic-core context and harness decisions, validate structured exchanges, modernize Rust MCP authoring guidance, assess supplied candidates, and close task tracking.",
      "open_decisions": [],
      "path": "todos/done/2026-09-27/agentic-core-enhancements-spec.md",
      "requirements": [
        {
          "id": "REQ-1",
          "statement": "Add smart-compact using exact active-host context telemetry only when exposed; otherwise label local estimates or unknown, and compact only after a durable phase-boundary handoff."
        },
        {
          "id": "REQ-2",
          "statement": "Add harness-distribution with fresh host-reported usage snapshots at task start, before expensive dispatches, and at meaningful phase boundaries; preserve unknown and fail closed before cross-harness contact when destination budget is stale, exhausted, or unknown."
        },
        {
          "id": "REQ-3",
          "statement": "Define language-neutral versioned exchange contracts and validate them before handoff and persistence; distinguish Git commit object IDs from SHA-256 artifact digests and verify repository claims when a repository is available."
        },
        {
          "id": "REQ-4",
          "statement": "Integrate version-grounded Rust MCP authoring guidance into the existing MCP route without presenting unverified snippets as current APIs."
        },
        {
          "id": "REQ-5",
          "statement": "Assess in-scope candidates from the supplied repository list for fit, integration, maturity, licensing, cost, and recommendation without adding unapproved integrations."
        },
        {
          "id": "REQ-6",
          "statement": "Treat agent_architect_ideas.md as a review-method brief rather than a prioritized proposal list; record a bounded and accurate architecture disposition."
        },
        {
          "id": "REQ-7",
          "statement": "Keep one tracking index for idea intake, active work, completion reports, and backlog; leave todos/in_progress empty at closure and classify unfinished work as backlog."
        },
        {
          "id": "REQ-8",
          "statement": "Preserve task_3 and harness_factory phase-1 source, tests, and canonical task ledger without task_4 edits."
        }
      ],
