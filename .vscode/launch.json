{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Copilot Tool Snapshot Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/copilot-tool-snapshot"
      ]
    }
  ]
}