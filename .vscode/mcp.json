{
  "servers": {
    "ahk": {
      "type": "stdio",
      "command": "npx",
      "args": ["--no-install", "ahk", "serve"],
      "env": {}
    },
    "gitnexus": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@duytransipher/gitnexus@latest", "mcp"],
      "env": {}
    },
    "graphify": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "scripts/atomic_index.py",
        "serve-graphify",
        "--db-path",
        ".graphify/lbug",
        "--report-path",
        "graphify-out/GRAPH_REPORT.md"
      ],
      "env": {}
    }
  }
}
